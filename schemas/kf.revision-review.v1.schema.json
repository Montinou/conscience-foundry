{"$defs":{"Reason":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"code":{"enum":["invalid_schema","unsupported_schema","limits_missing","limit_exceeded","forbidden","permission_unknown","source_missing","unsafe_path","source_changed","hash_mismatch","unsupported_format","invalid_encoding","bom_rejected","nul_rejected","empty_text","whitespace_only","invalid_span","revision_mismatch","budget_unconfigured","budget_exhausted","authorization_expired","dispatch_unknown","remote_failed","result_incomplete","determinism_conflict","storage_full","artifact_missing","schema_incompatible","activation_conflict","unsupported_capability","unavailable"],"title":"Code","type":"string"},"message":{"title":"Message","type":"string"}},"required":["code","message"],"title":"Reason","type":"object"}},"$id":"kf.revision-review.v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"actorId":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","title":"Actorid","type":"string"},"decision":{"enum":["accepted","needs_review","rejected"],"title":"Decision","type":"string"},"policyVersion":{"minLength":1,"title":"Policyversion","type":"string"},"projectId":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","title":"Projectid","type":"string"},"reason":{"$ref":"#/$defs/Reason"},"reviewedAt":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$","title":"Reviewedat","type":"string"},"revisionId":{"pattern":"^[0-9a-f]{64}$","title":"Revisionid","type":"string"},"schemaVersion":{"const":"kf.revision-review.v1","title":"Schemaversion","type":"string"}},"required":["schemaVersion","projectId","revisionId","decision","actorId","policyVersion","reviewedAt","reason"],"title":"RevisionReview","type":"object"}