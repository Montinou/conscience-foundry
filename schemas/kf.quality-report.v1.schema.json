{"$defs":{"QualityCheck":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"checkId":{"minLength":1,"title":"Checkid","type":"string"},"outcome":{"enum":["pass","fail","not_run"],"title":"Outcome","type":"string"},"reason":{"$ref":"#/$defs/Reason","default":null}},"required":["checkId","outcome"],"title":"QualityCheck","type":"object"},"Reason":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"code":{"enum":["invalid_schema","unsupported_schema","limits_missing","limit_exceeded","forbidden","permission_unknown","source_missing","unsafe_path","source_changed","hash_mismatch","unsupported_format","invalid_encoding","bom_rejected","nul_rejected","empty_text","whitespace_only","invalid_span","revision_mismatch","budget_unconfigured","budget_exhausted","authorization_expired","dispatch_unknown","remote_failed","result_incomplete","determinism_conflict","storage_full","artifact_missing","schema_incompatible","activation_conflict","unsupported_capability","unavailable"],"title":"Code","type":"string"},"message":{"title":"Message","type":"string"}},"required":["code","message"],"title":"Reason","type":"object"}},"$id":"kf.quality-report.v1","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"checks":{"items":{"$ref":"#/$defs/QualityCheck"},"title":"Checks","type":"array"},"disposition":{"enum":["valid","needs_review","quarantined"],"title":"Disposition","type":"string"},"schemaVersion":{"const":"kf.quality-report.v1","title":"Schemaversion","type":"string"},"sourceId":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","title":"Sourceid","type":"string"}},"required":["schemaVersion","sourceId","checks","disposition"],"title":"QualityReport","type":"object"}